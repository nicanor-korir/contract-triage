# Copy the lines you need into your shell, for example: export ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# Optional. Model names change, so check the provider's model list before the first run.
TRIAGE_MODEL=claude-sonnet-5
TRIAGE_VERIFIER_MODEL=claude-sonnet-5

# Optional. USD per million tokens, from the provider's pricing page.
# Without these the memo reports tokens and leaves cost blank.
TRIAGE_PRICE_INPUT_PER_MTOK=
TRIAGE_PRICE_OUTPUT_PER_MTOK=

# Optional. low | medium | high | xhigh | max. Lower effort means less thinking and a smaller bill,
# possibly with lower quality, so measure before changing it. Leave unset for Haiku 4.5.
TRIAGE_EFFORT=
